# Copy to .env and fill in.  Never commit .env.

# ── Backend / app ─────────────────────────────
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── Google OAuth (covers BOTH YouTube + Gmail — one consent screen) ──
# Create at https://console.cloud.google.com/  → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Scopes requested: youtube.readonly, gmail.readonly, userinfo.email

# ── LLM agent layer ───────────────────────────
# Runs on whichever AI subscription you already have, via its CLI — no API
# key needed. auto picks the first installed CLI:
#   claude (Claude Code — Anthropic subscription)
#   codex  (Codex CLI — ChatGPT Plus/Pro subscription)
#   gemini (Gemini CLI — free with a personal Google account)
# LLM_BACKEND: auto | claude-code | codex | gemini | api | off
LLM_BACKEND=auto
# Per-backend model. haiku = fast + light on your usage limits; empty = the
# CLI's own default. (claude: haiku/sonnet/opus · codex: e.g. gpt-5-codex ·
# gemini: e.g. gemini-2.5-flash)
LLM_MODEL=haiku
CODEX_MODEL=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback for deployments without any CLI:
ANTHROPIC_API_KEY=

# ── Vector store (RAG memory layer) ───────────
CHROMA_DIR=./.chroma

# ── Auth phase (added later) ──────────────────
DATABASE_URL=postgresql+psycopg://latent:latent@localhost:5432/latent
SECRET_KEY=change-me-to-a-random-string

# ── Frontend (Vite) ───────────────────────────
VITE_API_BASE_URL=http://localhost:8000
