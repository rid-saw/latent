# Copy to .env and fill in.  Never commit .env.

# ── Backend / app ─────────────────────────────
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── Google OAuth (covers BOTH YouTube + Gmail — one consent screen) ──
# Create at https://console.cloud.google.com/  → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Scopes requested: youtube.readonly, gmail.readonly, userinfo.email

# ── LLM agent layer ───────────────────────────
# Default (auto): uses YOUR Claude subscription via the Claude Code CLI —
# no API key needed, just `claude` installed and logged in.
# LLM_BACKEND: auto | claude-code | api | off
LLM_BACKEND=auto
# Model for agent calls (haiku = fast + light on your usage limits;
# empty = your Claude Code default; also accepts sonnet/opus)
LLM_MODEL=haiku
# Optional fallback for deployments without the CLI:
ANTHROPIC_API_KEY=

# ── Vector store (RAG memory layer) ───────────
CHROMA_DIR=./.chroma

# ── Auth phase (added later) ──────────────────
DATABASE_URL=postgresql+psycopg://latent:latent@localhost:5432/latent
SECRET_KEY=change-me-to-a-random-string

# ── Frontend (Vite) ───────────────────────────
VITE_API_BASE_URL=http://localhost:8000
